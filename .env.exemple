# Copier ce fichier en « .env » (même dossier) et remplir les valeurs.
# Le fichier .env n'est jamais publié ni committé.

# Supabase > Project Settings > API Keys (nouvelles clés sb_publishable_/sb_secret_ ou anciennes clés anon/service_role)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé PUBLIQUE : « Publishable key » (sb_publishable_…) ou « anon » — sert uniquement au formulaire de signalement
SUPABASE_ANON_KEY=
# Clé SECRÈTE : « Secret key » (sb_secret_…) ou « service_role » — NE JAMAIS LA METTRE DANS site/ NI LA PARTAGER
SUPABASE_SERVICE_ROLE_KEY=

# FACULTATIF — Netlify publie automatiquement depuis GitHub. Utile seulement pour « node outils/publier.js » en secours.
# Netlify > User settings > Applications > Personal access tokens
NETLIFY_AUTH_TOKEN=
# Netlify > Site configuration > Site details > Site ID
NETLIFY_SITE_ID=

# Dates des tours de l'élection, séparées par une virgule (à remplir à la publication du décret de convocation)
# Ex. : DATES_SCRUTIN=2027-04-11,2027-04-25
DATES_SCRUTIN=
